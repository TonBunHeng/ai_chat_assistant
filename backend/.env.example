# AI Configuration
AI_MODE=online
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=Camtour-On-Mistral-Ai:latest
ONLINE_API_KEY=your_api_key_here
ONLINE_MODEL=gpt-3.5-turbo

# Similarity Threshold (0.80 = 80%)
SIMILARITY_THRESHOLD=0.80

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "https://ai-chatbot-psi-sepia.vercel.app"]

# Database & Data Paths
SQLITE_DB_PATH=storage/conversations/conversations.db
DATA_DIR=data/tourism
VECTOR_DB_DIR=storage/vector_db

# History limit for conversation context
MAX_HISTORY_MESSAGES=10

