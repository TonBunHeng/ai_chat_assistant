# AI Configuration
AI_MODE=online
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=Camtour-On-Mistral-Ai:latest
ONLINE_API_KEY=your_api_key_here
